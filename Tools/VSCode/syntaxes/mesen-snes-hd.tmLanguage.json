{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Mesen HD Pack (SNES)",
  "scopeName": "source.mesen-snes-hd",
  "comment": "Généré par scripts/generate-grammar.py depuis schemas/29_schema_balises_snes.json. Ne pas éditer à la main.",
  "patterns": [
    {
      "name": "comment.line.number-sign.mesen-snes-hd",
      "match": "#.*$"
    },
    {
      "name": "meta.condition.mesen-snes-hd",
      "begin": "^\\s*\\[",
      "end": "\\]",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.condition.begin.mesen-snes-hd"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.condition.end.mesen-snes-hd"
        }
      },
      "patterns": [
        {
          "name": "keyword.operator.and.mesen-snes-hd",
          "match": "&"
        },
        {
          "name": "keyword.operator.not.mesen-snes-hd",
          "match": "!"
        },
        {
          "name": "support.function.condition.mesen-snes-hd",
          "match": "\\b(?:cgramMemoryCheckConstant|vramMemoryCheckConstant|aramMemoryCheckConstant|oamMemoryCheckConstant|ppuMemoryCheckConstant|spcMemoryCheckConstant|memoryCheckConstant|hmirror\\ /\\ vmirror|spriteAtPosition|cgramMemoryCheck|vramMemoryCheck|widescreenMode7|aramMemoryCheck|oamMemoryCheck|tileAtPosition|ppuMemoryCheck|spcMemoryCheck|spriteNearby|colorWindow|memoryCheck|widescreen|tileNearby|frameRange|hmirror|vmirror|gpu3d)\\b"
        },
        {
          "name": "constant.numeric.hash.mesen-snes-hd",
          "match": "\\b[0-9A-Fa-f]{8,16}\\b"
        },
        {
          "name": "constant.numeric.mesen-snes-hd",
          "match": "-?\\d+(?:\\.\\d+)?"
        },
        {
          "name": "keyword.operator.or.mesen-snes-hd",
          "match": "\\|"
        }
      ]
    },
    {
      "name": "punctuation.section.block.mesen-snes-hd",
      "match": "\\}>?|\\{"
    },
    {
      "name": "keyword.control.tag.mesen-snes-hd",
      "match": "<(?:disableAllColorMathWindow|disableColorMathWindow|disableOriginalSprites|disableOriginalTiles|disableColorMath|disablesublayer|setLayersOrder|LoadingScreen|2DPerspective|3DParticles|disableTile|tile_hvflip|m7billboard|tile_hflip|background|disableBg1|tile_vflip|widescreen|m7ambient|condition|2DOverlay|m7relief|msuToOgg|addition|fallback|overscan|2DLiquid|m7light|include|m7tiles|m7model|gpu3d|alias|video|m7img|scale|patch|tile|img)>"
    },
    {
      "name": "keyword.control.tag.mesen-snes-hd",
      "match": "(?i:<(?:m7LiquidBackground|NoLightFXOnSprite|Ignore2DOverlays|NoLiquidReflect|2DSpriteLight|spritelight|m7material|FrontOf3D|2DReflect|m7effect)>)"
    },
    {
      "name": "invalid.deprecated.tag.mesen-snes-hd",
      "match": "(?i:<(?:bgm|ver|sfx)>)"
    },
    {
      "name": "invalid.illegal.tag.mesen-snes-hd",
      "match": "<[^>\\s]*>"
    },
    {
      "name": "variable.parameter.mesen-snes-hd",
      "match": "(?<=[,>\\s])[A-Za-z_]\\w*(?==)"
    },
    {
      "name": "string.unquoted.path.mesen-snes-hd",
      "match": "[^\\s,\\[\\]{}<>=|#]+\\.(?i:png|ogg|json|obj|mtl|gltf|glb|mpg|mp4|txt|mesen)\\b"
    },
    {
      "name": "constant.numeric.hash.mesen-snes-hd",
      "match": "\\b[0-9A-Fa-f]{8,16}\\b"
    },
    {
      "name": "constant.numeric.mesen-snes-hd",
      "match": "(?<![\\w.])-?\\d+(?:\\.\\d+)?\\b"
    },
    {
      "name": "constant.language.boolean.mesen-snes-hd",
      "match": "\\b(?i:true|false|yes|no)\\b"
    },
    {
      "name": "keyword.operator.wildcard.mesen-snes-hd",
      "match": "\\*"
    },
    {
      "name": "keyword.operator.or.mesen-snes-hd",
      "match": "\\|"
    }
  ],
  "repository": {}
}
