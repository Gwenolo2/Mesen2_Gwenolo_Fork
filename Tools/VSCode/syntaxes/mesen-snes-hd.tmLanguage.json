{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Mesen HD Pack (SNES)",
  "scopeName": "source.mesen-snes-hd",
  "comment": "Généré par scripts/generate-grammar.py depuis schemas/29_schema_balises_snes.json. Ne pas éditer à la main.",
  "patterns": [
    {
      "name": "comment.line.number-sign.mesen-snes-hd",
      "match": "#.*$"
    },
    {
      "name": "meta.condition.mesen-snes-hd",
      "begin": "^\\s*\\[",
      "end": "\\]",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.condition.begin.mesen-snes-hd"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.condition.end.mesen-snes-hd"
        }
      },
      "patterns": [
        {
          "name": "keyword.operator.and.mesen-snes-hd",
          "match": "&"
        },
        {
          "name": "keyword.operator.not.mesen-snes-hd",
          "match": "!"
        },
        {
          "name": "support.function.condition.mesen-snes-hd",
          "match": "\\b(?:cgramMemoryCheckConstant|vramMemoryCheckConstant|aramMemoryCheckConstant|spcMemoryCheckConstant|oamMemoryCheckConstant|ppuMemoryCheckConstant|memoryCheckConstant|hmirror\\ /\\ vmirror|cgramMemoryCheck|spriteAtPosition|vramMemoryCheck|aramMemoryCheck|widescreenMode7|spcMemoryCheck|ppuMemoryCheck|tileAtPosition|oamMemoryCheck|spriteNearby|colorWindow|memoryCheck|tileNearby|widescreen|frameRange|hmirror|vmirror|gpu3d)\\b"
        },
        {
          "name": "constant.numeric.hash.mesen-snes-hd",
          "match": "\\b[0-9A-Fa-f]{8,16}\\b"
        },
        {
          "name": "constant.numeric.mesen-snes-hd",
          "match": "-?\\d+(?:\\.\\d+)?"
        },
        {
          "name": "keyword.operator.or.mesen-snes-hd",
          "match": "\\|"
        }
      ]
    },
    {
      "name": "punctuation.section.block.mesen-snes-hd",
      "match": "\\}>?|\\{"
    },
    {
      "name": "keyword.control.tag.mesen-snes-hd",
      "match": "<(?:disableAllColorMathWindow|disableColorMathWindow|disableOriginalSprites|disableOriginalTiles|disableColorMath|disablesublayer|setLayersOrder|2DPerspective|LoadingScreen|disableTile|tile_hvflip|m7billboard|3DParticles|background|tile_hflip|widescreen|disableBg1|tile_vflip|2DOverlay|condition|m7ambient|m7relief|addition|overscan|2DLiquid|msuToOgg|fallback|include|m7model|m7tiles|m7light|gpu3d|video|scale|m7img|patch|alias|tile|img)>"
    },
    {
      "name": "keyword.control.tag.mesen-snes-hd",
      "match": "(?i:<(?:m7LiquidBackground|NoLightFXOnSprite|Ignore2DOverlays|NoLiquidReflect|2DSpriteLight|spritelight|m7material|2DReflect|FrontOf3D|m7effect)>)"
    },
    {
      "name": "invalid.deprecated.tag.mesen-snes-hd",
      "match": "(?i:<(?:ver|bgm|sfx)>)"
    },
    {
      "name": "invalid.illegal.tag.mesen-snes-hd",
      "match": "<[^>\\s]*>"
    },
    {
      "name": "variable.parameter.mesen-snes-hd",
      "match": "(?<=[,>\\s])[A-Za-z_]\\w*(?==)"
    },
    {
      "name": "string.unquoted.path.mesen-snes-hd",
      "match": "[^\\s,\\[\\]{}<>=|#]+\\.(?i:png|ogg|json|obj|mtl|gltf|glb|mpg|mp4|txt|mesen)\\b"
    },
    {
      "name": "constant.numeric.hash.mesen-snes-hd",
      "match": "\\b[0-9A-Fa-f]{8,16}\\b"
    },
    {
      "name": "constant.numeric.mesen-snes-hd",
      "match": "(?<![\\w.])-?\\d+(?:\\.\\d+)?\\b"
    },
    {
      "name": "constant.language.boolean.mesen-snes-hd",
      "match": "\\b(?i:true|false|yes|no)\\b"
    },
    {
      "name": "keyword.operator.wildcard.mesen-snes-hd",
      "match": "\\*"
    },
    {
      "name": "keyword.operator.or.mesen-snes-hd",
      "match": "\\|"
    }
  ],
  "repository": {}
}
