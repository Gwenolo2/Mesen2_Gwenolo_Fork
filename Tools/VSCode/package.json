{
  "name": "mesen-hd-pack-snes",
  "displayName": "Mesen HD Pack (SNES, NES et Game Boy)",
  "description": "Coloration, aide et vérifications pour les packs HD de Mesen2 Gwenolo : SNES (snes_hires.txt), NES (hires.txt) et Game Boy (gb_hires.txt).",
  "version": "0.3.0",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:mesen-snes-hd",
    "onLanguage:mesen-nes-hd",
    "onLanguage:mesen-gb-hd"
  ],
  "contributes": {
    "languages": [
      {
        "id": "mesen-snes-hd",
        "aliases": [
          "Mesen HD Pack (SNES)"
        ],
        "filenames": [
          "snes_hires.txt"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "mesen-nes-hd",
        "aliases": [
          "Mesen HD Pack (NES)"
        ],
        "filenames": [
          "hires.txt"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "mesen-gb-hd",
        "aliases": [
          "Mesen HD Pack (Game Boy)"
        ],
        "filenames": [
          "gb_hires.txt"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "mesen-snes-hd",
        "scopeName": "source.mesen-snes-hd",
        "path": "./syntaxes/mesen-snes-hd.tmLanguage.json"
      },
      {
        "language": "mesen-nes-hd",
        "scopeName": "source.mesen-nes-hd",
        "path": "./syntaxes/mesen-nes-hd.tmLanguage.json"
      },
      {
        "language": "mesen-gb-hd",
        "scopeName": "source.mesen-gb-hd",
        "path": "./syntaxes/mesen-gb-hd.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "mesenHd.listConditions",
        "title": "Mesen HD : lister les conditions et includes du pack"
      },
      {
        "command": "mesenHd.toggleComment",
        "title": "Basculer le commentaire de ligne (#)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "mesenHd.toggleComment",
          "when": "editorLangId == mesen-snes-hd || editorLangId == mesen-nes-hd || editorLangId == mesen-gb-hd",
          "group": "1_modification"
        }
      ]
    }
  },
  "scripts": {
    "generate:grammar": "python3 scripts/generate-grammar.py",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
